<pre id="apps-script-code-block">/* Google Apps Script: 학술용 다단계 설문 응답 실시간 구글 시트 저장 및 자동 확장 컬럼 주입 (CORS-safe 및 동시 접속 Lock 동기화 대응판) */
function doPost(e) {
  // 동시 접속 충돌 방지를 위한 스크립트 락 획득 선언 (최대 30초 대기)
  var lock = LockService.getScriptLock();
  try {
    lock.waitLock(30000); // 30초 동안 대기하면서 동시 세션 충돌 완전 잠금 제어
    
    var sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
    var postData;
    
    // text/plain 전송 형식 및 일반 form-urlencoded 데이터의 전방위 복합 파싱 처리
    if (e && e.postData && e.postData.contents) {
      try {
        postData = JSON.parse(e.postData.contents);
      } catch (parseErr) {
        postData = e.parameter;
      }
    } else if (e && e.parameter) {
      postData = e.parameter;
    } else {
      throw new Error("전송된 데이터를 인식할 수 없습니다.");
    }
    
    // 첫 행 헤더 조회 및 신규 문항 ID 발생 시 자동 열 컬럼 추가
    var headers = sheet.getLastColumn() > 0 ? sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0] : [];
    
    // 고정 필드 헤더 체크 및 정렬
    var requiredHeaders = ["Timestamp", "UID"];
    for (var i = 0; i < requiredHeaders.length; i++) {
      if (headers.indexOf(requiredHeaders[i]) === -1) {
        headers.push(requiredHeaders[i]);
        sheet.getRange(1, headers.length).setValue(requiredHeaders[i]);
      }
    }
    
    // 전달받은 데이터 키값 분석 후 필요한 헤더 자동 보강
    var payloadKeys = Object.keys(postData);
    for (var j = 0; j < payloadKeys.length; j++) {
      var key = payloadKeys[j];
      if (headers.indexOf(key) === -1) {
        headers.push(key);
        sheet.getRange(1, headers.length).setValue(key);
      }
    }
    
    // 시트 헤더값 갱신 재로드
    headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
    
    // 신규 추가 행 데이터 준비
    var rowData = new Array(headers.length);
    rowData[headers.indexOf("Timestamp")] = new Date();
    rowData[headers.indexOf("UID")] = postData.UID || "Anonymous";
    
    for (var key in postData) {
      if (key !== "UID" && key !== "Timestamp") {
        var val = postData[key];
        // 오브젝트 형식은 JSON 텍스트화하여 저장
        if (typeof val === 'object') {
          val = JSON.stringify(val);
        }
        rowData[headers.indexOf(key)] = val;
      }
    }
    
    // 데이터 행 추가 실행
    sheet.appendRow(rowData);
    
    // CORS 보안 규격 준수 반환값 생성 (브라우저에서 읽을 수 있도록 세팅)
    return ContentService.createTextOutput(JSON.stringify({
      "result": "success",
      "message": "데이터가 안전하게 저장되었습니다."
    }))
    .setMimeType(ContentService.MimeType.JSON)
    .setHeader("Access-Control-Allow-Origin", "*");
    
  } catch (error) {
    return ContentService.createTextOutput(JSON.stringify({
      "result": "error",
      "message": error.toString()
    }))
    .setMimeType(ContentService.MimeType.JSON)
    .setHeader("Access-Control-Allow-Origin", "*");
  } finally {
    lock.releaseLock(); // 데이터 기록 완료 후 다른 스레드를 위해 잠금 제어권 자동 해제
  }
}</pre>
