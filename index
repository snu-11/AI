    function updateProgressTracker() {
      const totalSections = surveyConfig.sections.length;
      document.getElementById('survey-step-indicator').innerText = `영역 ${currentSectionIndex + 1} / ${totalSections}`;
      
      const percent = Math.round(((currentSectionIndex) / (totalSections)) * 100);
      document.getElementById('survey-percent-indicator').innerText = `완료율 ${percent}%`;
      document.getElementById('survey-progress-bar').style.width = `${percent}%`;

      const prevBtn = document.getElementById('btn-survey-prev');
      if (currentSectionIndex === 0) {
        prevBtn.classList.add('invisible');
      } else {
        prevBtn.classList.remove('invisible');
      }

      const nextBtn = document.getElementById('btn-survey-next');
      const nextBtnText = document.getElementById('btn-survey-next-text');
      const nextBtnIcon = document.getElementById('btn-survey-next-icon');
      if (currentSectionIndex === totalSections - 1) {
        nextBtnText.innerText = "설문 응답 제출";
        nextBtnIcon.className = "fa-solid fa-paper-plane text-xs";
      } else {
        nextBtnText.innerText = "다음 단계";
        nextBtnIcon.className = "fa-solid fa-chevron-right text-xs";
      }
    }

    // 응답 신뢰성 및 정성 검증 알고리즘 (7개 연속 동일 응답 감지 및 복습 우회 메커니즘 탑재)
    function checkResponseQuality() {
      // 이미 이전에 도달해 본 세션이라면 속도 트랩(Speed trap) 우회
      if (currentSectionIndex < maxVisitedSectionIndex) {
        return { success: true };
      }

      const currentSec = surveyConfig.sections[currentSectionIndex];
      
      // 1. 응답 속도 분석기 (Speed Trap)
      let totalQuestionsCount = 0;
      currentSec.questions.forEach(q => {
        if (q.type === 'matrix') {
          totalQuestionsCount += q.rows.length;
        } else {
          totalQuestionsCount += 1;
        }
      });
      
      const elapsedSeconds = (Date.now() - sectionStartTime) / 1000;
      if (totalQuestionsCount > 2 && elapsedSeconds < (totalQuestionsCount * 1.0)) {
        sectionStartTime = Date.now(); // 타이머 리셋
        return {
          success: false,
          title: "안내", 
          message: "앗! 지금 너무 빠르게 답변하고 있습니다. 내용을 천천히 읽으며 답변해 주세요! ⏱️😊"
        };
      }
      
      // 2. 연속 동일 답변 분석기 (7개 이상 연속 감지)
      for (let q of currentSec.questions) {
        if (q.type === 'matrix') {
          const rowAnswers = surveyAnswers[q.id] || {};
          let lastAnswer = null;
          let streakCount = 0;
          let longestStreak = 0;
          
          q.rows.forEach(row => {
            const currentAns = rowAnswers[row.id];
            if (currentAns !== undefined && currentAns !== null) {
              if (currentAns === lastAnswer) {
                streakCount++;
              } else {
                streakCount = 1;
              }
              if (streakCount > longestStreak) {
                longestStreak = streakCount;
              }
              lastAnswer = currentAns;
            }
          });
          
          if (longestStreak >= 7) {
            return {
              success: false,
              title: "신뢰성 확인 ✍️🙏✨",
              message: "현재 계속 같은 답변을 체크하고 계십니다. 실제로 모든 문항에 대한 생각이나 감정이 일치할 수 있으나, 문항의 세부 내용을 다시 한 번 생각하고 답변해 주시면 정말 감사하겠습니다!"
            };
          }
        }
      }
      
      return { success: true };
    }

    function validateSectionResponses() {
      const currentSec = surveyConfig.sections[currentSectionIndex];
      
      // 기존에 남아있는 에러 하이라이트 테두리들을 깨끗하게 초기화
      currentSec.questions.forEach(q => {
        const wrap = document.getElementById(`q-container-${q.id}`);
        if (wrap) {
          wrap.className = "space-y-2.5 pt-4 border-t border-slate-100/70 p-3 rounded-2xl transition-all duration-300 border border-transparent";
        }
      });

      // 3단계 수업 수 비례 정밀 검증
      if (currentSec.id === "sec_ai_usage_stats") {
        const a = parseInt(surveyAnswers["Q0_1_a"]) || 0;
        const b = parseInt(surveyAnswers["Q0_1_b"]) || 0;
        const c = parseInt(surveyAnswers["Q0_1_c"]) || 0;
        const d = parseInt(surveyAnswers["Q0_1_d"]) || 0;
        
        if (a < 1) {
          return { success: false, message: "수강 수업 개수(A)는 최소 1개 이상이어야 합니다.", missingId: "Q0_1_a" };
        }
        if (b + c + d !== a) {
          return { success: false, message: `상세 분류의 합(B + C + D = ${b + c + d}개)이 전체 수강 수업 수(A = ${a}개)와 일치해야 합니다. 수치를 다시 확인하고 재입력해 주세요.` };
        }
      }

      // 2단계 학점 표 필수 검증 처리
      if (currentSec.id === "sec_demographic_detail") {
        const gradeVal = surveyAnswers["SQ9_val"];
        const gradeMax = surveyAnswers["SQ9_max"];
        
        if (!gradeVal || gradeVal.trim() === "") {
          highlightMissingQuestion("SQ9_grade_table");
          return { success: false, message: "SQ9-1. 귀하의 평점 학점을 입력해 주십시오.", missingId: "SQ9_grade_table" };
        }
        if (!gradeMax || gradeMax.trim() === "") {
          highlightMissingQuestion("SQ9_grade_table");
          return { success: false, message: "SQ9-2. 평점 학점의 기준 만점을 입력해 주십시오.", missingId: "SQ9_grade_table" };
        }

        const numericVal = parseFloat(gradeVal);
        const numericMax = parseFloat(gradeMax);

        if (isNaN(numericVal) || isNaN(numericMax)) {
          highlightMissingQuestion("SQ9_grade_table");
          return { success: false, message: "평점 학점 정보는 소수점을 포함한 숫자 형식으로만 입력해 주세요.", missingId: "SQ9_grade_table" };
        }
        if (numericVal > numericMax) {
          highlightMissingQuestion("SQ9_grade_table");
          return { success: false, message: "평점 학점은 기준 만점 이하로 입력해야 합니다.", missingId: "SQ9_grade_table" };
        }
      }

      // 9단계 2차 조사 동의 시 전화번호 필수 입력 검증 유효성 처리
      if (currentSec.id === "sec_second_survey_consent") {
        const agreement = surveyAnswers["C2_AGR"];
        const phoneNumber = surveyAnswers["C2_PHONE"];
        if (agreement && agreement.startsWith("참여동의")) {
          if (!phoneNumber || phoneNumber.trim() === "") {
            highlightMissingQuestion("C2_PHONE");
            return { success: false, message: "2차 조사에 참여 동의하셨으므로 설문조사 완료 경품(커피 쿠폰) 발송 및 개별 연락을 위한 '연락처 입력(Q11-1)' 항목은 필수입니다. 연락처를 기입해 주시기 바랍니다.", missingId: "C2_PHONE" };
          }
        }
      }

      for (let q of currentSec.questions) {
        if (q.id === "SQ5_other" && surveyAnswers["SQ5"] !== "기타") continue;
        if (q.id === "SQ7_other" && surveyAnswers["SQ7"] !== "기타") continue;
        if (q.id === "Q0_4_other" && !(surveyAnswers["Q0_4"] || []).includes("기타")) continue;
        if (q.id === "SQ9_grade_table") continue; 

        if (!q.required) continue;

        const cleanedQuestionText = stripHtml(q.text);

        if (q.type === 'matrix') {
          const rowAnswers = surveyAnswers[q.id] || {};
          for (let row of q.rows) {
            if (!rowAnswers[row.id]) {
              highlightMissingQuestion(q.id);
              const cleanedRowText = stripHtml(row.text);
              return { success: false, message: `"${cleanedQuestionText}" 문항 중 \n\n[세부 문항 - ${cleanedRowText}]\n\n항목에 아직 응답하지 않으셨습니다. 모든 세부 질문에 답변해주셔야 이동 가능합니다.`, missingId: q.id };
            }
          }
        } else {
          const val = surveyAnswers[q.id];
          if (val === undefined || val === null || val === "" || (Array.isArray(val) && val.length === 0)) {
            highlightMissingQuestion(q.id);
            return { success: false, message: `"${cleanedQuestionText}" 항목은 필수 입력값입니다.`, missingId: q.id };
          }
        }
      }
      return { success: true };
    }

    function highlightMissingQuestion(qId) {
      const qWrap = document.getElementById(`q-container-${qId}`);
      if (qWrap) {
        qWrap.className = "space-y-2.5 pt-4 border-rose-500 bg-rose-50/20 p-3 rounded-2xl transition-all duration-300 border-2 ring-4 ring-rose-100 shadow-sm";
        qWrap.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }

