      document.getElementById('survey-percent-indicator').innerText = '0%';
      document.getElementById('survey-progress-bar').style.width = '0%';
      document.getElementById('survey-progress-bar').className = "bg-rose-500 h-full rounded-full transition-all duration-500";
      
      document.getElementById('disqualified-reason').innerHTML = reasonText;
      document.getElementById('disqualified-screen').classList.remove('hidden');
      document.getElementById('survey-navigation-footer').classList.add('hidden');
    }

    function evaluateBranchingLogic(realtimeOnly = false) {
      // 1) AGR Consent Block check
      if (currentSectionIndex === 0) {
        if (realtimeOnly) return true;
        const consentAns = surveyAnswers["AGR"] || {};
        if (consentAns["1"] === "아니오" || consentAns["2"] === "아니오") {
          triggerDisqualification("안녕하세요, 귀중한 관심을 보여주시고 본 설문에 접근해 주셔서 대단히 감사드립니다.<br><br>아쉽게도 본 연구의 학술 취지 설명에 동의하지 않으셨거나 참여 의사 확인 보장이 수립되지 않아 설문 진행 대상에서 해제되었습니다.<br><br>비록 본 조사는 완수하지 못하게 되었으나 참여 결정 수립에 귀한 시간 내주셔서 진심으로 고맙습니다. 다음 기회에 더 유익한 인연으로 꼭 다시 만나 뵙기를 고대하며, 귀하의 가치 있고 앞선 일상에 늘 행복과 행운이 가득하시기를 소망합니다!");
          return false;
        }
      }

      // 2) SQ1 ~ SQ4 Screen-out block check
      if (currentSectionIndex === 1) {
        if (realtimeOnly) return true;
        
        // SQ4 학적 스크리닝
        const sq4Ans = surveyAnswers["SQ4"] || "";
        if (sq4Ans.startsWith("대학(원)생 휴학생")) {
          triggerDisqualification("안녕하세요, 소중한 시간 내어주셔서 진심으로 감사드립니다!<br><br>아쉽게도 본 연구는 현재 대학교 및 대학원에 <strong>'재학 중'</strong>인 학생분들만을 대상으로 한정하여 정밀 연구를 진행하고 있어, 부득이하게 설문 진행이 어렵게 되었습니다.<br><br>비록 이번 설문은 여기서 매듭짓지만, 여러분이 제공해주신 정성과 관심에 깊이 감사드리며 다음 연구나 기회에서 더 나은 인연으로 꼭 다시 뵙기를 소망하겠습니다. 항상 기쁨과 행운이 가득하시길 진심으로 응원합니다!");
          return false;
        }

        // SQ1 purpose checks
        const sq1Ans = surveyAnswers["SQ1"] || [];
        if (sq1Ans.includes("사용해 본 적 없음")) {
          triggerDisqualification("안녕하세요, 귀중한 관심을 베풀어 주셔서 대단히 고맙습니다!<br><br>본 설문조사는 대학교 내 학습 과정에서 생성형 AI를 실제로 활용해 보신 분들의 고도 의존 양식을 파악하기 위해 마련되었습니다. 이에 따라 생성형 AI를 다뤄보신 경험이 없는 경우 아쉽게도 연구 대상 조건에서 부득이 제외됩니다.<br><br>비록 이번 조사는 여기서 인사드리지만, 다음 기회에 다른 경로로 더 따뜻하게 다시 마주하기를 소망합니다. 언제나 안전하고 행복 가득한 일상만 함께하시기를 진심으로 바랍니다!");
          return false;
        }
        if (!sq1Ans.includes("공부/과제/학업 목적")) {
          triggerDisqualification("안녕하세요, 바쁘신 일정 속에서도 귀한 시간을 쪼개어 응답에 동참해주셔서 감사합니다!<br><br>본 과업은 대학의 수업 및 '학업 상황(공부, 리포트 작성, 과제 수행 등)'과 연계된 특화 의존도를 진단하는 연구이므로, 대학 학업 목적으로 사용해보신 경험이 없는 경우에는 조사 설계 조건상 설문이 자동 종결됩니다.<br><br>비록 이번에는 여기서 인사드리지만, 향후 더 넓은 범위의 학술 프로젝트에서 꼭 다시 한 번 뵐 수 있기를 손꼽아 기다리겠습니다. 오늘 하루도 보람차고 평안하게 마무리하시기를 기원합니다!");
          return false;
        }

        // SQ3 Age restriction
        const ageVal = parseInt(surveyAnswers["SQ3"]);
        if (ageVal < 19) {
          triggerDisqualification("안녕하세요! 귀중한 관심을 보여주시고 참여해 주셔서 진심으로 감사드립니다.<br><br>본 학술 연구는 기관 윤리 기준에 따라 '만 19세 이상'의 대학(원)생 연구 참여자 보호 장치를 수립하여 운영하고 있어, 만 19세 미만 미성년자의 경우 참여가 제한됩니다.<br><br>비록 이번에는 아쉽게도 여기서 인사드리지만, 다음 기회에 더 따뜻한 자리에서 꼭 다시 만날 수 있기를 희망합니다. 하시는 모든 일에 늘 기쁨과 건강이 함께하길 기원합니다!");
          return false;
        }
      }

      // 3) Attention check validation (Q6_1 #99)
      if (currentSectionIndex === 5) {
        const q6_1Ans = surveyAnswers["Q6_1"] || {};
        const attentionAns = q6_1Ans["99"];
        if (attentionAns === "보통이다" || attentionAns === "그렇다" || attentionAns === "매우 그렇다") {
          triggerDisqualification("안녕하세요, 본 연구 조사에 정성 들여 참여해 주셔서 대단히 감사드립니다.<br><br>이번 설문지는 학습 과정에서 생성형 AI를 주도적으로 다루시는 분들을 대상으로 일관된 신뢰도 척도를 정립하기 위한 목적을 가지고 있습니다. 다만 확인 결과, <strong>검증 문항(Q6-1. 99번 행: '나는 생성형 AI를 한 번도 사용해 본 적이 없다')</strong>에 실수가 있거나 맞지 않는 정보가 감지되어 부득이하게 설문 진행이 중단되었습니다.<br><br>착오로 오클릭하셨을 수도 있으나 무결성 연구 검증 표준에 준하여 완료 처리가 불가한 점 너른 양해 부탁드립니다. 소중한 지식 공유에 참여해 주셔서 다시 한번 진심으로 감사드리며, 다음 기회에 더 훌륭한 연구를 통해 소중한 인연으로 꼭 다시 뵙기를 소망합니다. 언제나 건강하시고 늘 평안한 일상 보내세요!");
          return false;
        }
      }

      return true;
    }

    function handleSurveyPrev() {
      if (currentSectionIndex > 0) {
        currentSectionIndex--;
        qualityWarningShown = false; 
        renderSurveySectionContent();
        updateProgressTracker();
        sectionStartTime = Date.now(); 
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }

    function handleSurveyNext() {
      const check = validateSectionResponses();
      if (!check.success) {
        openSurveyModal("입력 확인", check.message, "warning");
        return;
      }

      const isEligible = evaluateBranchingLogic();
      if (!isEligible) return; 

      // 속도 및 연속 응답 퀄리티 체크
      if (!qualityWarningShown) {
        const qualityResult = checkResponseQuality();
        if (!qualityResult.success) {
          qualityWarningShown = true; 
          openSurveyModal(
            qualityResult.title, 
            qualityResult.message, 
            "warning", 
            null 
          );
          return;
        }
      }

      // 성공적으로 통과하여 전진한 경우 최대 도달 세션 기록 갱신 (뒤로가기 시 복습속도 면제)
      maxVisitedSectionIndex = Math.max(maxVisitedSectionIndex, currentSectionIndex + 1);
      proceedToNextSection();
    }

    function proceedToNextSection() {
      const totalSections = surveyConfig.sections.length;
      if (currentSectionIndex < totalSections - 1) {
        currentSectionIndex++;
        qualityWarningShown = false; 
        renderSurveySectionContent();
        updateProgressTracker();
        sectionStartTime = Date.now(); 
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        submitSurveyData();
      }
    }

    function submitSurveyData() {
      const endpoint = surveyConfig.webAppUrl;
      
      if (!endpoint || endpoint.trim() === "" || endpoint.includes("YOUR_URL_HERE")) {
        openSurveyModal(
          "서버 연동 대기 모드 (개발자 테스트)", 
          "축하합니다! 신뢰 검증 문항과 학적 스크리닝 필터를 모두 통과하셨습니다!\n\n현재 이 임시 페이지에는 구글 시트 웹앱 URL이 설정되지 않았습니다. 관리자 설정의 [구글 연동] 탭에서 Apps Script 연동 후 저장하시면 실제 데이터베이스에 실시간 기록이 시작됩니다.", 
          "success"
        );
        showSurveyCompletedScreen();
        return;
      }

      const nextBtn = document.getElementById('btn-survey-next');
      const waitMask = document.getElementById('wait-loading-mask');
      
      // 전송 중 유실 방지를 위한 더블 디펜스 스파이크 가드
      nextBtn.disabled = true;
      nextBtn.innerHTML = `<i class="fa-solid fa-circle-notch animate-spin mr-1.5"></i> 전송 중...`;
      
      // 화면 전체에 전송 강제 안전 대기 마스크 오버레이 노출
      if (waitMask) {
        waitMask.classList.remove('hidden');
        waitMask.classList.add('flex');
      }

      // Structure Submission Object (Flattens Matrices & Array inputs safely)
      const submitPayload = {
        UID: uid,
        Timestamp: new Date().toISOString()
      };

      for (let key in surveyAnswers) {
        const val = surveyAnswers[key];
        if (val !== null && val !== undefined) {
          if (typeof val === 'object' && !Array.isArray(val)) {
            // Flattens matrices responses: questionId_rowId = value
            for (let subKey in val) {
              if (val[subKey] !== undefined && val[subKey] !== null) {
                submitPayload[`${key}_${subKey}`] = val[subKey];
              }
            }
          } else if (Array.isArray(val)) {
            submitPayload[key] = val.join(', ');
          } else {
            submitPayload[key] = val;
          }
        }
      }

      // CORS Preflight를 피하기 위한 'Simple Request' 규격 만족용 헤더 text/plain 적용 및 redirect: follow 강제 정의
      fetch(endpoint, {
        method: "POST",
        headers: {
          "Content-Type": "text/plain;charset=utf-8" // OPTIONS Preflight 사전 검증 요청을 회피하여 다이렉트 전송
        },
        body: JSON.stringify(submitPayload),
        redirect: "follow" // 구글 웹앱 리다이렉션을 추적하도록 규정
      })
      .then(response => {
        if (!response.ok) {
          throw new Error("HTTP 오류 코드: " + response.status);
        }
        return response.text();
      })
      .then(() => {
        // 성공 시 대기 마스크 오프 및 다음 전환
        if (waitMask) {
          waitMask.classList.add('hidden');
          waitMask.classList.remove('flex');
        }
        nextBtn.disabled = false;
        showSurveyCompletedScreen();
      })
      .catch((err) => {
        if (waitMask) {
          waitMask.classList.add('hidden');
          waitMask.classList.remove('flex');
        }
        nextBtn.disabled = false;
        nextBtn.innerHTML = `<span>다시 제출</span><i class="fa-solid fa-paper-plane text-xs"></i>`;
        openSurveyModal(
          "전송 실패 디버깅 안내 🔧🔍", 
