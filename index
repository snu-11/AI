    function copyAppsScriptCode() {
      const code = document.getElementById('apps-script-code-block').innerText;
      
      const tempTextArea = document.createElement("textarea");
      tempTextArea.value = code;
      document.body.appendChild(tempTextArea);
      tempTextArea.select();
      
      try {
        document.execCommand('copy');
        openSurveyModal("복사 완료", "서버용 구글 Apps Script 소스코드가 클립보드에 무사히 복사되었습니다. 구글 웹 앱 편집창에 곧바로 붙여넣으십시오.", "success");
      } catch (err) {
        console.error('복사 실패: ', err);
      }
      document.body.removeChild(tempTextArea);
    }

    function downloadCustomSurveyHtml() {
      const docClone = document.documentElement.cloneNode(true);
      const scripts = docClone.querySelectorAll('script');
      
      scripts.forEach(scr => {
        const src = scr.getAttribute('src');
        const content = scr.textContent || '';
        
        if (src && src.includes('tailwindcss.com')) {
          return;
        }
        
        if (content.includes('let surveyConfig =') || content.includes('window.onload')) {
          const configStr = JSON.stringify(surveyConfig, null, 2);
          const regex = /let surveyConfig = \{[\s\S]*?\};/;
          
          let modifiedContent = content.replace(regex, `let surveyConfig = ${configStr};`);
          modifiedContent = modifiedContent.replace("let isAdminParamEnabled = urlParams.get('admin') === 'true';", "let isAdminParamEnabled = false;");
          
          scr.textContent = modifiedContent;
          return;
        }
        
        scr.remove();
      });

      const respView = docClone.querySelector('#respondent-view');
      if (respView) {
        respView.classList.remove('hidden');
      }
      const adminView = docClone.querySelector('#admin-view');
      if (adminView) {
        adminView.classList.add('hidden');
      }
      
      const adminToggleContainer = docClone.querySelector('#admin-mode-toggle-container');
      if (adminToggleContainer) {
        adminToggleContainer.remove();
      }
      
      const contentContainer = docClone.querySelector('#survey-content-container');
      if (contentContainer) {
        contentContainer.innerHTML = '<!-- Injected dynamic elements -->';
      }
      
      const progressIndicator = docClone.querySelector('#survey-step-indicator');
      if (progressIndicator) {
        progressIndicator.innerText = '영역 1 / 11';
        progressIndicator.className = 'custom-accent-text';
      }
      const percentIndicator = docClone.querySelector('#survey-percent-indicator');
      if (percentIndicator) {
        percentIndicator.innerText = '완료율 0%';
      }
      const progressBar = docClone.querySelector('#survey-progress-bar');
      if (progressBar) {
        progressBar.style.width = '0%';
        progressBar.className = 'custom-accent-bg h-full rounded-full transition-all duration-500';
      }
      
      const uidDisplay = docClone.querySelector('#respondent-uid-display');
      if (uidDisplay) {
        uidDisplay.innerText = 'GUEST';
      }
      
      const disqScreen = docClone.querySelector('#disqualified-screen');
      if (disqScreen) {
        disqScreen.classList.add('hidden');
      }
      
      const navFooter = docClone.querySelector('#survey-navigation-footer');
      if (navFooter) {
        navFooter.classList.remove('hidden');
      }
      const prevBtn = docClone.querySelector('#btn-survey-prev');
      if (prevBtn) {
        prevBtn.classList.add('invisible');
      }
      const nextBtn = docClone.querySelector('#btn-survey-next');
      if (nextBtn) {
        nextBtn.classList.remove('hidden');
        nextBtn.disabled = false;
        const nextBtnText = nextBtn.querySelector('#btn-survey-next-text');
        if (nextBtnText) nextBtnText.innerText = '다음 단계';
        const nextBtnIcon = nextBtn.querySelector('#btn-survey-next-icon');
        if (nextBtnIcon) nextBtnIcon.className = 'fa-solid fa-chevron-right text-xs';
      }

      const cleanedHtml = docClone.outerHTML;

      const element = document.createElement('a');
      const file = new Blob([`<!DOCTYPE html>\n` + cleanedHtml], {type: 'text/html;charset=utf-8'});
      element.href = URL.createObjectURL(file);
      element.download = "index.html";
      document.body.appendChild(element);
      element.click();
      document.body.removeChild(element);
      
      openSurveyModal("내보내기 성공", "로컬 맞춤 구성과 구글 시트 URL이 주입되고, 관리자 모드 버튼이 완벽히 숨김 처리된 배포용 'index.html' 파일이 자동 다운로드되었습니다. 이 파일을 그대로 GitHub 레포지토리에 올리시면 됩니다!", "success");
    }
