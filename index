    function handleSQ1Checkboxes(optValue, isChecked) {
      const sq1Checked = surveyAnswers['SQ1'] || [];

      if (optValue === "사용해 본 적 없음") {
        if (isChecked) {
          surveyAnswers['SQ1'] = ["사용해 본 적 없음"];
        } else {
          surveyAnswers['SQ1'] = [];
        }
      } else {
        if (isChecked) {
          const filtered = sq1Checked.filter(x => x !== "사용해 본 적 없음");
          if (!filtered.includes(optValue)) {
            filtered.push(optValue);
          }
          surveyAnswers['SQ1'] = filtered;
        } else {
          surveyAnswers['SQ1'] = sq1Checked.filter(x => x !== optValue);
        }
      }
      renderSurveySectionContent();
    }

    function saveAnswer(qId, val, skipRender = false) {
      // SQ4 '대학(원)생 휴학생...' 선택 시 즉각 처리
      if (qId === "SQ4" && val.startsWith("대학(원)생 휴학생")) {
        surveyAnswers[qId] = val;
        triggerDisqualification("안녕하세요, 귀중한 시간을 할애하여 설문에 참여해 주셔서 진심으로 감사드립니다!<br><br>아쉽게도 본 학술 조사는 대학교 및 대학원에 <strong>'재학 중'</strong>인 학생분들만을 대상으로 분석을 진행하고 있어, 부득이하게 설문 진행이 어렵게 되었습니다.<br><br>비록 이번 조사는 여기서 매듭짓지만, 여러분이 제공해주신 귀중한 정성 마음에 깊이 감사드리며 다음 연구나 기획에서 더 따뜻하고 뜻깊은 인연으로 꼭 다시 뵙기를 소망하겠습니다. 환절기 늘 건강 유의하시고 웃음 가득한 나날 보내시길 기원합니다!");
        return;
      }

      // Q11-1 휴대폰 번호 전용 입력일 시 숫자 이외의 문자 즉시 박멸 처리
      if (qId === "C2_PHONE") {
        val = val.replace(/[^0-9]/g, '');
        const phoneEl = document.getElementById('input_C2_PHONE');
        if (phoneEl) phoneEl.value = val;
      }

      surveyAnswers[qId] = val;
      
      // 학년(SQ8)은 재학생/대학원생 분류(SQ4) 결과에 의존하므로 리셋 로직 매칭
      if (qId === "SQ4") {
        delete surveyAnswers["SQ8"];
      }

      // 학점 테이블 실시간 검증 핸들러
      if (qId === "SQ9_val" || qId === "SQ9_max") {
        validateGradeValue(qId, val);
      }
      
      // 실시간 검증 체크
      if (qId === "Q6_1") {
        evaluateBranchingLogic(true);
      }
      
      if (!skipRender) {
        renderSurveySectionContent();
      }
    }

    function validateGradeValue(qId, val) {
      const filteredVal = val.replace(/[^0-9.]/g, '');
      surveyAnswers[qId] = filteredVal;
      const el = document.getElementById(`input_${qId}`);
      if (el) el.value = filteredVal;
    }

    function saveCheckboxAnswer(qId, opt, isChecked) {
      if (!surveyAnswers[qId]) {
        surveyAnswers[qId] = [];
      }
      if (isChecked) {
        if (!surveyAnswers[qId].includes(opt)) {
          surveyAnswers[qId].push(opt);
        }
      } else {
        surveyAnswers[qId] = surveyAnswers[qId].filter(x => x !== opt);
      }
      renderSurveySectionContent();
    }

    function saveMatrixValue(qId, rowId, col) {
      if (!surveyAnswers[qId]) {
        surveyAnswers[qId] = {};
      }
      surveyAnswers[qId][rowId] = col;
      renderSurveySectionContent();

      // Q6_1 99번 행 선택 시 실시간 스크리닝 체크
      if (qId === "Q6_1" && rowId === "99") {
        evaluateBranchingLogic(true);
      }

      // 7개 이상 연속으로 동일한 답변을 기재했을 때만 검증 경고 작동
      const currentSec = surveyConfig.sections[currentSectionIndex];
      for (let q of currentSec.questions) {
        if (q.id === qId && q.type === 'matrix') {
          const rowAnswers = surveyAnswers[q.id] || {};
          let lastAnswer = null;
          let streakCount = 0;
          let longestStreak = 0;
          
          q.rows.forEach(row => {
            const currentAns = rowAnswers[row.id];
            if (currentAns !== undefined && currentAns !== null) {
              if (currentAns === lastAnswer) {
                streakCount++;
              } else {
                streakCount = 1;
              }
              if (streakCount > longestStreak) {
                longestStreak = streakCount;
              }
              lastAnswer = currentAns;
            }
          });
          
          if (longestStreak >= 7 && !qualityWarningShown) {
            qualityWarningShown = true; // 경고 플래그 차단 작동
            openSurveyModal(
              "신뢰성 확인 ✍️🙏✨",
              "현재 계속 같은 답변을 체크하고 계십니다. 실제로 모든 문항에 대한 생각이나 감정이 일치할 수 있으나, 문항의 세부 내용을 다시 한 번 생각하고 답변해 주시면 정말 감사하겠습니다!",
              "warning"
            );
          }
        }
      }
    }

